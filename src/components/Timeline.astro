---
import { Image } from "astro:assets";
import avatarImg from "../assets/images/davideiken-1200.jpg";
// Note: If you have a signature image, import it here.
// For now, we will leave a placeholder for the signature.

interface Props {
  headingLeft?: string;
  headingRight?: string;
}

const { headingLeft = "Selbstständig", headingRight = "Angestellt" } =
  Astro.props;
---

<div class="timeline-container">
  <div class="timeline-header">
    <div class="avatar-wrapper avatar-top">
      <Image
        src={avatarImg}
        alt="David Eiken"
        class="avatar"
        width={160}
        height={160}
        densities={[1.5, 2]}
      />
    </div>
  </div>

  <div class="timeline-track">
    <div class="center-line">
      <!-- Arrow at the bottom of the line -->
      <div class="arrow-down">
        <svg
          width="40"
          height="20"
          viewBox="0 0 40 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M1 1L20 18L39 1"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
      </div>
    </div>

    <div class="timeline-headings desktop-only">
      <h2 class="heading-left">{headingLeft}</h2>
      <h2 class="heading-right">{headingRight}</h2>
    </div>

    <ul class="timeline-list">
      <slot />
    </ul>
  </div>

  <div class="timeline-footer">
    <div class="footer-profile">
      <div class="avatar-wrapper avatar-bottom">
        <Image
          src={avatarImg}
          alt="David Eiken"
          class="avatar"
          width={160}
          height={160}
          densities={[1.5, 2]}
        />
      </div>
      <h2>David Maciejewski</h2>
      <p class="name-note">(ab 21. August 2026: Eiken)</p>

      <div class="signature-placeholder">
        <!-- Add your signature image here later -->
        <span class="sr-only">Signature</span>
      </div>
    </div>
  </div>
</div>

<style>
  .timeline-container {
    margin-block: var(--sp-3xl);
    position: relative;
    --c-timeline-gap: var(--sp-l);
  }

  .timeline-header {
    display: flex;
    justify-content: flex-start; /* left align */
    align-items: center;
    position: relative;
    z-index: 2; /* above center-line */
  }

  .avatar-wrapper {
    width: 100px;
    height: 100px;
    overflow: hidden;
    position: relative;
    z-index: 2;
    background: var(--clr-bg);
    transition:
      width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .avatar-top {
    border-radius: 50% 50% 50% 0; /* flat bottom-left */
  }

  .avatar-bottom {
    border-radius: 0 50% 50% 50%; /* flat top-left */
  }

  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .desktop-only {
    display: none;
  }

  .timeline-track {
    position: relative;
    padding-top: var(--sp-xl);
    padding-bottom: var(--sp-xl);
    z-index: 1;
  }

  .center-line {
    anchor-name: --center-line;
    position: absolute;
    left: 0; /* flush with the left straight edge of the avatar */
    top: -20px;
    bottom: -20px;
    width: 3px;
    background: var(--clr-text);
    z-index: -1;
    transition:
      left 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .arrow-down {
    position: absolute;
    bottom: -20px;
    left: 0; /* align with extreme left line */
    transform: translateX(-35%) translateY(100%); /* slight adjustment since line is flush left */
    color: var(--clr-text);
    transition:
      left 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline-headings {
    margin-bottom: var(--sp-2xl);
  }

  .timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    z-index: 2;
    padding-left: 20px; /* max space for content */
    transition: padding-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* left align */
    text-align: left;
    position: relative;
    z-index: 2;
  }

  .footer-profile h2 {
    font-size: var(--fs-2xl);
    margin: var(--sp-m) 0 0.2rem;
  }

  .name-note {
    font-size: var(--fs-s);
    font-style: italic;
    color: var(--clr-text-muted);
    margin: 0 0 var(--sp-xl);
  }

  .signature-placeholder {
    width: 200px;
    height: 100px;
    border-bottom: 1px solid var(--clr-text-muted);
    margin-inline: auto;
    opacity: 0.5;
  }

  /* --- Desktop Layout --- */
  @media (min-width: 768px) {
    .timeline-header {
      justify-content: center;
    }

    .timeline-footer {
      align-items: center;
      text-align: center;
    }

    .avatar-wrapper {
      width: 140px;
      height: 140px;
      border-radius: 50%; /* reset to circle */
    }

    .avatar-top,
    .avatar-bottom {
      border-radius: 50%; /* reset to circle */
    }

    .arrow-down {
      left: 50%;
    }

    .desktop-only {
      display: grid;
      grid-template-columns: 1fr 2px 1fr;
      gap: 0 var(--c-timeline-gap);
      text-align: center;
    }

    .heading-left {
      grid-column: 1;
      font-size: var(--fs-xl);
      margin: 0;
      text-align: right;
    }

    .heading-right {
      grid-column: 3;
      font-size: var(--fs-xl);
      margin: 0;
      text-align: left;
    }

    .center-line {
      left: 50%;
      transform: translateX(-50%);
      top: -40px; /* reaches up to the top avatar */
      bottom: -40px; /* reaches down to the bottom avatar */
    }

    .arrow-down {
      bottom: -40px; /* sit exactly at the end of the line */
      transform: translateX(-50%) translateY(100%);
    }

    .timeline-list {
      display: grid;
      grid-template-columns: 1fr 2px 1fr;
      gap: 0 var(--c-timeline-gap);
      padding-left: 0;
    }
  }
</style>
