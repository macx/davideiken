---
import { Image } from "astro:assets";
import avatarImg from "../assets/images/davideiken-1200.jpg";
import DavidSign from "../assets/images/david-sign.svg";

interface Props {
  headingLeft?: string;
  headingRight?: string;
  accessibilityHeading?: string;
}

const {
  headingLeft = "Selbstständig",
  headingRight = "Angestellt",
  accessibilityHeading,
} = Astro.props;
---

<div class="timeline-container">
  <div class="timeline-header">
    <div class="avatar-wrapper avatar-top">
      <Image
        src={avatarImg}
        alt="David Eiken"
        class="avatar"
        width={240}
        height={240}
        densities={[1.5, 2]}
      />
    </div>
  </div>

  <div class="timeline-track">
    <div class="center-line">
      <!-- Arrow at the bottom of the line -->
      <div class="arrow-down">
        <svg
          width="40"
          height="20"
          viewBox="0 0 40 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M1 1L20 18L39 1"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
      </div>
    </div>

    <!-- Gekurvte Verbindungslinien auf Mobile -->
    <div class="connector-top" aria-hidden="true">
      <svg
        class="connector-top-left"
        width="30"
        height="60"
        viewBox="0 0 30 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M 30,27 L 16.5,27 A 15,15 0 0 0 1.5,42 L 1.5,60"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="square"
          fill="none"></path>
      </svg>
      <div class="connector-top-middle"></div>
      <svg
        class="connector-top-right"
        width="30"
        height="60"
        viewBox="0 0 30 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M 30,0 L 30,12 A 15,15 0 0 1 15,27 L 0,27"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="square"
          fill="none"></path>
      </svg>
    </div>

    <div class="connector-bottom" aria-hidden="true">
      <svg
        class="connector-bottom-left"
        width="30"
        height="60"
        viewBox="0 0 30 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M 1.5,0 L 1.5,18 A 15,15 0 0 0 16.5,33 L 30,33"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="square"
          fill="none"></path>
      </svg>
      <div class="connector-bottom-middle"></div>
      <svg
        class="connector-bottom-right"
        width="30"
        height="60"
        viewBox="0 0 30 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M 0,33 L 15,33 A 15,15 0 0 1 30,48 L 30,60"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="square"
          fill="none"></path>
      </svg>
    </div>

    <div class="timeline-headings">
      <h2 class="heading-left desktop-only">{headingLeft}</h2>
      <h2 class="heading-right desktop-only">{headingRight}</h2>
      <h2 class="visually-hidden">{accessibilityHeading}</h2>
    </div>

    <ul class="timeline-list">
      <slot />
    </ul>
  </div>

  <div class="timeline-footer">
    <div class="footer-profile">
      <div class="avatar-wrapper avatar-bottom">
        <Image
          src={avatarImg}
          alt="David Eiken"
          class="avatar"
          width={240}
          height={240}
          densities={[1.5, 2]}
        />
      </div>

      <h2>David Eiken</h2>
      <p class="name-note">(geb. Maciejewski)</p>

      <div class="signature sr-only">
        <DavidSign />
      </div>
    </div>
  </div>
</div>

<style>
  .timeline-container {
    margin-block: var(--sp-l) var(--sp-2xl);
    position: relative;
    --c-timeline-gap: var(--sp-l);
  }

  .timeline-header {
    display: flex;
    justify-content: center; /* zentriert auf mobile */
    align-items: center;
    position: relative;
    z-index: 2; /* above center-line */
  }

  .avatar-wrapper {
    inline-size: 120px;
    block-size: 120px;
    border-radius: 50%; /* kreisrund auf mobile und desktop */
    overflow: hidden;
    position: relative;
    z-index: 2;
    background: var(--clr-bg);
    transition:
      inline-size 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      block-size 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .avatar-top,
  .avatar-bottom {
    border-radius: 50%;
  }

  .avatar {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .desktop-only {
    display: none;
  }

  .timeline-track {
    position: relative;
    padding-block: 1em var(--sp-2xl);
    z-index: 1;
  }

  .center-line {
    anchor-name: --center-line;
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 60px; /* schließt an connector-top an */
    inset-block-end: 60px; /* schließt an connector-bottom an */
    inline-size: 3px;
    background: var(--clr-text);
    z-index: -1;
    transition:
      inset-inline-start 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      inset-block-start 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      inset-block-end 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .arrow-down {
    display: none; /* auf mobile ausgeblendet, da linie abknickt */
  }

  .connector-top,
  .connector-bottom {
    display: block;
    position: absolute;
    z-index: 1;
    color: var(--clr-text);
    inset-inline-start: 0;
    inline-size: 50%;
    block-size: 60px;
    pointer-events: none;
  }

  .connector-top {
    inset-block-start: 0;
  }

  .connector-bottom {
    inset-block-end: 0;
  }

  .connector-top svg,
  .connector-bottom svg {
    position: absolute;
    display: block;
    overflow: visible;
  }

  .connector-top-left,
  .connector-bottom-left {
    inset-inline-start: 0;
  }

  .connector-top-right,
  .connector-bottom-right {
    inset-inline-end: 0;
  }

  .connector-top-middle,
  .connector-bottom-middle {
    position: absolute;
    inset-inline: 30px;
    block-size: 3px;
    background: currentColor;
  }

  .connector-top-middle {
    inset-block-start: 25.5px;
  }

  .connector-bottom-middle {
    inset-block-start: 31.5px;
  }

  .timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-block-start: var(
      --sp-xl
    ); /* clears the connector-top curve (60px incl. track padding) */
    position: relative;
    z-index: 2;
    padding-inline-start: 20px; /* max space for content */
    transition: padding-inline-start 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline-footer {
    display: flex;
    flex-direction: column;
    align-items: center; /* zentriert auf mobile */
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .footer-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-profile h2 {
    font-size: var(--fs-2xl);
    margin-block: var(--sp-m) 0.2rem;
    margin-inline: 0;
  }

  .name-note {
    font-size: var(--fs-s);
    font-style: italic;
    color: var(--clr-text-muted);
    margin-block: 0 var(--sp-xl);
    margin-inline: 0;
  }

  .signature {
    inline-size: 12em;
    block-size: auto;
    margin-inline: auto;
    transform: translateX(2.5ch);
  }

  /* --- Desktop Layout --- */
  @media (min-width: 768px) {
    .timeline-track {
      padding-block-start: var(--sp-xl);
    }

    .timeline-header {
      justify-content: center;
    }

    .timeline-footer {
      align-items: center;
      text-align: center;
    }

    .avatar-wrapper {
      inline-size: 180px;
      block-size: 180px;
    }

    .connector-top,
    .connector-bottom {
      display: none;
    }

    .arrow-down {
      display: block;
      position: absolute;
      inset-block-end: -40px; /* sit exactly at the end of the line */
      inset-inline-start: 50%;
      transform: translateX(-50%) translateY(100%);
      color: var(--clr-text);
    }

    .desktop-only {
      display: block;
    }

    .timeline-headings {
      display: grid;
      grid-template-columns: 1fr 2px 1fr;
      gap: 0 var(--c-timeline-gap);
      text-align: center;
      margin-block-end: var(--sp-2xl);
    }

    .heading-left {
      grid-column: 1;
      font-size: var(--fs-xl);
      margin: 0;
      text-align: end;
    }

    .heading-right {
      grid-column: 3;
      font-size: var(--fs-xl);
      margin: 0;
      text-align: start;
    }

    .center-line {
      inset-inline-start: 50%;
      transform: translateX(-50%);
      inset-block-start: -60px; /* reaches up to the top avatar */
      inset-block-end: -60px; /* reaches down to the bottom avatar */
    }

    .arrow-down {
      inset-block-end: -40px; /* sit exactly at the end of the line */
      transform: translateX(-50%) translateY(100%);
    }

    .timeline-list {
      display: grid;
      grid-template-columns: 1fr 2px 1fr;
      gap: 0 var(--c-timeline-gap);
      padding-inline-start: 0;
      margin-block-start: 0;
    }
  }
</style>
