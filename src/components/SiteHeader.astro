---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAlternates } from "../i18n/routes";
import ThemeToggle from "./ThemeToggle.astro";
import Tooltip from "./Tooltip.astro";
import { Image } from "astro:assets";
import avatarImg from "../assets/images/davideiken-1200.jpg";
import Logo from "../assets/brand.svg";

interface PageModule {
  frontmatter?: {
    navTitle?: string;
    navOrder?: number;
  };
}

const modules = import.meta.glob<PageModule>("../pages/**/*.{astro,mdx}", {
  eager: true,
});

const locale = Astro.currentLocale ?? "en";
const targetLocale = locale === "en" ? "de" : "en";

function toLocaleAndSlug(filePath: string): { locale: string; slug: string } {
  let route = filePath
    .replace(/^\.\.\/pages\//, "")
    .replace(/\.(astro|mdx)$/, "")
    .replace(/\/index$/, "");

  const parts = route.split("/").filter(Boolean);
  const pageLocale = parts[0] === "en" ? "en" : "de";
  const slug = pageLocale === "en" ? parts.slice(1).join("/") : parts.join("/");

  return { locale: pageLocale, slug };
}

const allLocaleItems = Object.entries(modules)
  .map(([path, mod]) => ({
    mod,
    ...toLocaleAndSlug(path),
  }))
  .filter((item) => item.locale === locale && item.mod.frontmatter?.navTitle)
  .sort(
    (a, b) =>
      (a.mod.frontmatter?.navOrder ?? 99) - (b.mod.frontmatter?.navOrder ?? 99),
  )
  .map((item) => ({
    label: item.mod.frontmatter!.navTitle!,
    href: getRelativeLocaleUrl(locale, item.slug),
    slug: item.slug,
  }));

const desktopNavItems = allLocaleItems.filter(
  (item) => item.slug !== "contact",
);
const drawerNavItems = [
  {
    label: locale === "de" ? "Startseite" : "Home",
    href: getRelativeLocaleUrl(locale, ""),
    slug: "",
  },
  ...desktopNavItems,
  {
    label: locale === "de" ? "Kontakt" : "Contact",
    href: "#contact",
    slug: "contact",
  },
];

const navItems = desktopNavItems.map((item) => ({
  label: item.label,
  href: item.href,
}));

const currentPath = Astro.url.pathname;
const currentSlug =
  locale === "en"
    ? currentPath.replace(/^\/en\/?/, "")
    : currentPath.replace(/^\//, "");
const alternates = getAlternates(currentPath);
const languageSwitchHref = alternates
  ? alternates[targetLocale]
  : getRelativeLocaleUrl(targetLocale, currentSlug);
const languageSwitchLabel = targetLocale === "de" ? "DE" : "EN";
const navLabel = locale === "de" ? "Hauptnavigation" : "Main navigation";
const openLabel = locale === "de" ? "Navigation öffnen" : "Open navigation";
const closeLabel =
  locale === "de" ? "Navigation schließen" : "Close navigation";
const homeSuffix = locale === "de" ? "Startseite" : "Home";
const contactHref = "#contact";
---

<header class="site-header" role="banner">
  <!-- Floating glass pill -->
  <div class="nav-pill">
    <nav class="site-nav" aria-label={navLabel}>
      <ul class="nav-list">
        <li class="nav-item logo-item">
          <a href={getRelativeLocaleUrl(locale, "")} class="site-logo">
            <span class="logo-stack">
              <Logo width={48} height={48} class="logo-mark logo-svg" />
              <Image
                src={avatarImg}
                alt=""
                aria-hidden="true"
                class="logo-mark avatar-mark"
                width={48}
                height={48}
                densities={[1.5, 2]}
                loading="eager"
              />
            </span>
            <span class="logo-wordmark"
              >David Eiken<span class="visually-hidden"> {homeSuffix}</span
              ></span
            >
          </a>
        </li>

        {
          navItems.map((item) => (
            <li class="nav-item text-link-item">
              <a
                href={item.href}
                class:list={[
                  "nav-link",
                  { "is-active": currentPath === item.href },
                ]}
                aria-current={currentPath === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }

        <li class="nav-divider-item" aria-hidden="true">
          <span class="nav-divider"></span>
        </li>

        <li class="nav-item icon-link-item">
          <Tooltip
            as="a"
            href={contactHref}
            class="nav-icon-link contact-link"
            aria-label={locale === "de" ? "Kontakt" : "Contact"}
            text={locale === "de" ? "Kontakt" : "Contact"}
            position="bottom"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z"
                stroke="currentColor"
                stroke-width="1.5"></path>
              <path d="m4 8 8 6 8-6" stroke="currentColor" stroke-width="1.5"
              ></path>
            </svg>
          </Tooltip>
        </li>
        <li class="nav-item icon-link-item">
          <ThemeToggle
            class="nav-icon-link header-theme-toggle"
            locale={locale}
          />
        </li>
        <li class="nav-item icon-link-item">
          <Tooltip
            as="a"
            href={languageSwitchHref}
            hreflang={targetLocale}
            lang={targetLocale}
            class="nav-icon-link lang-switch"
            aria-label={locale === "de"
              ? "Switch to English"
              : "Auf Deutsch wechseln"}
            text={locale === "de"
              ? "Switch to English"
              : "Auf Deutsch wechseln"}
            position="bottom"
          >
            <span>{languageSwitchLabel}</span>
          </Tooltip>
        </li>
      </ul>
      <span class="nav-indicator" aria-hidden="true"></span>

      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-controls="nav-drawer"
        aria-expanded="false"
        aria-label={openLabel}
        data-label-open={openLabel}
        data-label-close={closeLabel}
        popovertarget="nav-drawer"
        popovertargetaction="toggle"
      >
        <!-- Hamburger -->
        <svg
          class="icon-menu"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          aria-hidden="true"
        >
          <line
            x1="2"
            y1="5"
            x2="16"
            y2="5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="2"
            y1="9"
            x2="16"
            y2="9"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="2"
            y1="13"
            x2="16"
            y2="13"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
        </svg>
        <!-- Close -->
        <svg
          class="icon-close"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          aria-hidden="true"
        >
          <line
            x1="4"
            y1="4"
            x2="14"
            y2="14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="14"
            y1="4"
            x2="4"
            y2="14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile drawer (glass panel, separate from pill) -->
  <div class="nav-drawer" id="nav-drawer" popover="auto" aria-hidden="true">
    {
      drawerNavItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "drawer-link",
            "drawer-link-no-icon",
            { "is-active": currentPath === item.href },
          ]}
          aria-current={currentPath === item.href ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <a
      class="drawer-link"
      href={languageSwitchHref}
      hreflang={targetLocale}
      lang={targetLocale}
    >
      <span class="drawer-icon-placeholder lang-icon" aria-hidden="true"
        >{languageSwitchLabel}</span
      >
      <span class="drawer-link-text"
        >{locale === "de" ? "English" : "Deutsch"}</span
      >
    </a>
    <ThemeToggle class="drawer-link" variant="drawer" locale={locale} />
  </div>
</header>

<script>
  const toggle = document.getElementById(
    "nav-toggle",
  ) as HTMLButtonElement | null;
  const drawer = document.getElementById("nav-drawer") as HTMLElement | null;
  const supportsPopover = typeof drawer?.showPopover === "function";
  let drawerWasOpen = false;

  function setClosedState() {
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute(
      "aria-label",
      toggle?.dataset.labelOpen ?? "Open navigation",
    );
    drawer?.setAttribute("aria-hidden", "true");
    if (!supportsPopover) drawer?.classList.remove("is-open");
    drawer?.setAttribute("inert", "");
    if (drawerWasOpen) {
      toggle?.focus();
      drawerWasOpen = false;
    }
  }

  function setOpenState() {
    toggle?.setAttribute("aria-expanded", "true");
    toggle?.setAttribute(
      "aria-label",
      toggle?.dataset.labelClose ?? "Close navigation",
    );
    drawer?.setAttribute("aria-hidden", "false");
    drawer?.removeAttribute("inert");
    if (!supportsPopover) drawer?.classList.add("is-open");
    drawerWasOpen = true;
    requestAnimationFrame(() => {
      drawer?.querySelector<HTMLElement>("a")?.focus();
    });
  }

  function close() {
    if (supportsPopover) {
      drawer?.hidePopover();
      return;
    }

    setClosedState();
  }

  setClosedState();

  if (supportsPopover) {
    drawer?.addEventListener("toggle", () => {
      if (drawer.matches(":popover-open")) {
        setOpenState();
      } else {
        setClosedState();
      }
    });

    drawer?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("a")) {
        close();
      }
    });
  } else {
    toggle?.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        setClosedState();
      } else {
        setOpenState();
      }
    });

    document.addEventListener("click", (event) => {
      const pill = document.querySelector(".nav-pill");
      if (
        !pill?.contains(event.target as Node) &&
        !drawer?.contains(event.target as Node)
      ) {
        setClosedState();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setClosedState();
    });

    drawer?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("a")) {
        setClosedState();
      }
    });
  }
</script><style>
  @keyframes logoFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes avatarFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .site-header {
    position: fixed;
    inset-block-start: var(--sp);
    inset-inline: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-xs);
    pointer-events: none;

    .nav-pill {
      anchor-name: --nav-pill;
      pointer-events: auto;
      position: relative;
      display: flex;
      align-items: stretch;
      height: 3.25rem;
      gap: var(--sp-xs);
      padding-block: 0;
      padding-inline-start: 0.5rem;
      padding-inline-end: 0.5rem;
      border-radius: 9999px;

      /* Clean, Flat, Bold Glass */
      background: color-mix(in oklch, var(--clr-surface) 65%, transparent);
      -webkit-backdrop-filter: blur(24px) saturate(140%);
      backdrop-filter: blur(24px) saturate(140%);

      /* Crisp border, flat minimal shadow */
      border: 1.5px solid color-mix(in oklch, var(--clr-text) 12%, transparent);
      box-shadow: 0 4px 16px -4px color-mix(in oklch, black 12%, transparent);
    }

    .nav-divider-item {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-inline: var(--sp-2xs);
    }

    .nav-divider {
      width: 1px;
      height: 1.1rem;
      background: color-mix(in oklch, var(--clr-text) 16%, transparent);
      flex-shrink: 0;
    }

    .site-logo {
      display: flex;
      align-items: center;
      gap: var(--sp-xs);
      text-decoration: none;
      color: var(--clr-text);
      flex-shrink: 0;
      align-self: center;
      padding-block: 0.35rem;
      padding-inline-start: 0;
      padding-inline-end: 0.65rem;
      border-radius: 9999px;
      transition: background 150ms ease;
      position: relative;
      z-index: 1;

      &::before {
        content: "";
        position: absolute;
        inset-block: 0.15rem;
        inset-inline-start: -0.25rem;
        inset-inline-end: 0.25rem;
        border-radius: 9999px;
        background: transparent;
        z-index: -1;
        transition: background 150ms ease;
      }

      &:hover::before,
      &:focus-visible::before {
        background: color-mix(in oklch, var(--clr-text) 6%, transparent);
      }
    }

    .logo-stack {
      display: grid;
      grid-template-areas: "stack";
      width: 2.25rem;
      height: 2.25rem;
      flex-shrink: 0;
    }

    .logo-mark {
      grid-area: stack;
      display: inline-block;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid color-mix(in oklch, var(--clr-text) 15%, transparent);
    }

    .logo-svg {
      opacity: 1;
    }

    .avatar-mark {
      opacity: 0;
    }

    /* Progressive Enhancement: Logo/Avatar-Swap via Scroll-Driven Animation */
    @supports (animation-timeline: scroll()) {
      --c-trigger-point: 20vh;

      .logo-svg {
        animation: logoFadeOut linear both;
        animation-timeline: scroll(root);
        animation-range: var(--c-trigger-point)
          calc(var(--c-trigger-point) + 120px);
      }

      .avatar-mark {
        animation: avatarFadeIn linear both;
        animation-timeline: scroll(root);
        animation-range: var(--c-trigger-point)
          calc(var(--c-trigger-point) + 120px);
      }
    }

    .logo-wordmark {
      font-size: var(--fs-s);
      font-weight: 700;
      letter-spacing: -0.025em;
    }

    .site-nav {
      position: relative;
      display: flex;
      align-items: stretch;
      width: 100%;
      height: 100%;
    }

    .nav-list {
      display: flex;
      align-items: stretch;
      gap: 2px;
      list-style: none;
      padding: 0;
      margin: 0;
      width: 100%;
    }

    .nav-item {
      display: flex;
      align-items: stretch;
    }

    .nav-link {
      display: flex;
      align-items: center;
      padding-inline: 0.8rem;
      border-radius: 9999px;
      font-size: var(--fs-xs);
      font-weight: 500;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: color-mix(in oklch, var(--clr-text) 80%, transparent);
      text-decoration: none;
      position: relative;
      z-index: 1;
      transition: color 180ms ease;

      &::before {
        content: "";
        position: absolute;
        inset-block: 0.35rem;
        inset-inline: 0.25rem;
        border-radius: 9999px;
        background: transparent;
        z-index: -1;
        transition: background 180ms ease;
      }

      &:hover,
      &:focus-visible {
        color: var(--clr-text);
      }

      &:hover::before,
      &:focus-visible::before {
        background: color-mix(in oklch, var(--clr-text) 6%, transparent);
      }

      &.is-active {
        color: var(--clr-text);
      }

      &.is-active::before {
        background: color-mix(in oklch, var(--clr-text) 8%, transparent);
      }
    }

    .nav-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 100%;
      align-self: stretch;
      padding: 0;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--clr-text);
      position: relative;
      z-index: 1;
      border-radius: 50%;

      &::before {
        content: "";
        position: absolute;
        width: 2.05rem;
        height: 2.05rem;
        left: 50%;
        top: 50%;
        translate: -50% -50%;
        border-radius: 50%;
        background: transparent;
        z-index: -1;
        transition: background 150ms ease;
      }

      &:hover,
      &:focus-visible {
      }

      &:hover::before,
      &:focus-visible::before {
        background: color-mix(in oklch, var(--clr-text) 9%, transparent);
      }

      .icon-close {
        display: none;
      }

      .icon-menu {
        display: block;
      }

      &[aria-expanded="true"] {
        .icon-close {
          display: block;
        }

        .icon-menu {
          display: none;
        }
      }

      @media (max-width: 40em) {
        display: flex;
        margin-inline-start: auto;
      }
    }

    .nav-icon-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 100%;
      color: color-mix(in oklch, var(--clr-text) 80%, transparent);
      text-decoration: none;
      position: relative;
      z-index: 1;
      transition: color 160ms ease;
      border-radius: 50%;

      &::before {
        content: "";
        position: absolute;
        width: 2.05rem;
        height: 2.05rem;
        left: 50%;
        top: 50%;
        translate: -50% -50%;
        border-radius: 50%;
        background: transparent;
        z-index: -1;
        transition: background 160ms ease;
      }

      &:hover,
      &:focus-visible {
        color: var(--clr-text);
      }

      &:hover::before,
      &:focus-visible::before {
        background: color-mix(in oklch, var(--clr-text) 8%, transparent);
      }
    }

    .lang-switch {
      font-size: var(--fs-2xs);
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    @supports (anchor-name: --test) {
      /* Statische Hover-Hintergründe deaktivieren, wenn der gleitende Indikator aktiv ist */
      .site-logo:hover::before,
      .nav-link:hover::before,
      .nav-icon-link:hover::before {
        background: transparent !important;
      }

      .logo-item .site-logo {
        anchor-name: --nav-logo;
      }

      .nav-item:nth-child(2) .nav-link {
        anchor-name: --nav-1;
      }

      .nav-item:nth-child(3) .nav-link {
        anchor-name: --nav-2;
      }

      .nav-item:nth-child(4) .nav-link {
        anchor-name: --nav-3;
      }

      .nav-item:nth-child(5) .nav-link {
        anchor-name: --nav-4;
      }

      /* Icons */
      .nav-item:nth-child(5) .nav-icon-link {
        anchor-name: --nav-contact;
      }

      .nav-item:nth-child(6) .nav-icon-link {
        anchor-name: --nav-theme;
      }

      .nav-item:nth-child(7) .nav-icon-link {
        anchor-name: --nav-lang;
      }

      .nav-indicator {
        position: absolute;
        position-anchor: --nav-1;
        top: calc(anchor(top) + 0.35rem);
        height: calc(anchor-size(height) - 0.7rem);
        left: calc(anchor(left) + 0.25rem);
        width: calc(anchor-size(width) - 0.5rem);
        border-radius: 9999px;
        background: color-mix(in oklch, var(--clr-text) 7%, transparent);
        opacity: 0;
        pointer-events: none;
        transition:
          left 240ms cubic-bezier(0.4, 0, 0.2, 1),
          width 240ms cubic-bezier(0.4, 0, 0.2, 1),
          top 240ms cubic-bezier(0.4, 0, 0.2, 1),
          height 240ms cubic-bezier(0.4, 0, 0.2, 1),
          border-radius 240ms cubic-bezier(0.4, 0, 0.2, 1),
          opacity 160ms ease;
      }

      /* Logo Hover State */
      .site-nav:has(.logo-item .site-logo:hover) .nav-indicator {
        position-anchor: --nav-logo;
        top: calc(anchor(top) + 0.15rem);
        height: calc(anchor-size(height) - 0.3rem);
        left: calc(anchor(left) - 0.25rem);
        width: calc(anchor-size(width) + 0.5rem);
        border-radius: 9999px;
      }

      /* Active Link Anchor Mappings */
      .site-nav:has(.nav-item:nth-child(2) .nav-link.is-active) .nav-indicator {
        position-anchor: --nav-1;
      }

      .site-nav:has(.nav-item:nth-child(3) .nav-link.is-active) .nav-indicator {
        position-anchor: --nav-2;
      }

      .site-nav:has(.nav-item:nth-child(4) .nav-link.is-active) .nav-indicator {
        position-anchor: --nav-3;
      }

      .site-nav:has(.nav-item:nth-child(5) .nav-link.is-active) .nav-indicator {
        position-anchor: --nav-4;
      }

      /* Text Link Hover States */
      .site-nav:has(.text-link-item .nav-link:hover) .nav-indicator {
        top: calc(anchor(top) + 0.35rem);
        height: calc(anchor-size(height) - 0.7rem);
        border-radius: 9999px;
      }

      .site-nav:has(.nav-item:nth-child(2) .nav-link:hover) .nav-indicator {
        position-anchor: --nav-1;
        left: calc(anchor(left) + 0.25rem);
        width: calc(anchor-size(width) - 0.5rem);
      }

      .site-nav:has(.nav-item:nth-child(3) .nav-link:hover) .nav-indicator {
        position-anchor: --nav-2;
        left: calc(anchor(left) + 0.25rem);
        width: calc(anchor-size(width) - 0.5rem);
      }

      .site-nav:has(.nav-item:nth-child(4) .nav-link:hover) .nav-indicator {
        position-anchor: --nav-3;
        left: calc(anchor(left) + 0.25rem);
        width: calc(anchor-size(width) - 0.5rem);
      }

      .site-nav:has(.nav-item:nth-child(5) .nav-link:hover) .nav-indicator {
        position-anchor: --nav-4;
        left: calc(anchor(left) + 0.25rem);
        width: calc(anchor-size(width) - 0.5rem);
      }

      /* Icon Hover States (Morph to centered circles) */
      .site-nav:has(.icon-link-item .nav-icon-link:hover) .nav-indicator {
        width: 2.05rem;
        height: 2.05rem;
        top: calc(anchor(top) + anchor-size(height) / 2 - 1.025rem);
        border-radius: 50%;
      }

      .site-nav:has(.nav-item:nth-child(5) .nav-icon-link:hover)
        .nav-indicator {
        position-anchor: --nav-contact;
        left: calc(anchor(left) + anchor-size(width) / 2 - 1.025rem);
      }

      .site-nav:has(.nav-item:nth-child(6) .nav-icon-link:hover)
        .nav-indicator {
        position-anchor: --nav-theme;
        left: calc(anchor(left) + anchor-size(width) / 2 - 1.025rem);
      }

      .site-nav:has(.nav-item:nth-child(7) .nav-icon-link:hover)
        .nav-indicator {
        position-anchor: --nav-lang;
