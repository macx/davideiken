---
const { action = "/api/contact" } = Astro.props;

const lang = (Astro.currentLocale as "en" | "de") || "en";

const messages = {
  en: {
    name: "Name",
    email: "Email",
    message: "Message",
    send: "Send Message",
    sending: "Sending...",
    success: "Message sent successfully! I will get back to you soon.",
    error: "Something went wrong. Please try again.",
    networkError:
      "Network error or server unavailable (500). Please try again later.",
  },
  de: {
    name: "Name",
    email: "E-Mail",
    message: "Nachricht",
    send: "Nachricht senden",
    sending: "Wird gesendet...",
    success:
      "Vielen Dank! Die Nachricht wurde erfolgreich gesendet. Ich melde mich in Kürze.",
    error: "Es ist ein Fehler aufgetreten. Bitte versuche es noch einmal.",
    networkError:
      "Netzwerkfehler oder Server-Problem (500). Bitte versuche es später noch einmal.",
  },
};

const t = messages[lang];
---

<form
  class="contact-form"
  action={action}
  method="POST"
  id="contactForm"
  data-msg-sending={t.sending}
  data-msg-success={t.success}
  data-msg-error={t.error}
  data-msg-network={t.networkError}
>
  <div class="form-content">
    <div class="form-group honeypot" aria-hidden="true">
      <label for="fax">Fax (Leave this empty)</label>
      <input type="text" id="fax" name="fax" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="name">{t.name}</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="100"
          autocomplete="name"
        />
      </div>

      <div class="form-group">
        <label for="email">{t.email}</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          maxlength="100"
          autocomplete="email"
        />
      </div>
    </div>

    <div class="form-group">
      <label for="message">{t.message}</label>
      <textarea
        id="message"
        name="message"
        required
        minlength="10"
        maxlength="3000"
        rows="5"></textarea>
    </div>

    <button type="submit" class="submit-btn" id="submitBtn">{t.send}</button>
  </div>

  <div id="formStatus" class="form-status" aria-live="polite"></div>
</form>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  const statusEl = document.getElementById("formStatus");
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

  if (form && statusEl && submitBtn) {
    const msgSending = form.dataset.msgSending || "Sending...";
    const msgSuccess = form.dataset.msgSuccess || "Success!";
    const msgError = form.dataset.msgError || "Error";
    const msgNetwork = form.dataset.msgNetwork || "Network error";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);

      statusEl.textContent = msgSending;
      statusEl.className = "form-status sending";
      submitBtn.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && result.success) {
          statusEl.textContent = msgSuccess;
          statusEl.className = "form-status success";
          form.classList.add("is-success");
          form.reset();
        } else {
          // If 500 error or validation error
          statusEl.textContent = result.error || msgError;
          statusEl.className = "form-status error";
          submitBtn.disabled = false;
        }
      } catch (err) {
        statusEl.textContent = msgNetwork;
        statusEl.className = "form-status error";
        submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-s);
  }

  .form-content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-m);
  }

  .contact-form.is-success .form-content {
    display: none;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: var(--sp-m);
  }

  @media (min-width: 40em) {
    .form-row {
      flex-direction: row;
      gap: var(--sp-m);
    }

    .form-row .form-group {
      flex: 1;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .honeypot {
    display: none;
  }

  label {
    font-family: var(--ff-copy, sans-serif);
    font-size: var(--fs-xs);
    color: var(--clr-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  input,
  textarea {
    font-family: var(--ff-copy, sans-serif);
    font-size: 1rem;
    padding: 0.75rem 0.5rem;
    border: none;
    border-bottom: 3px solid var(--clr-text);
    background: color-mix(in oklch, var(--clr-text) 5%, transparent);
    color: var(--clr-text);
    border-radius: 0;
    transition:
      border-color 0.2s ease,
      outline-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--clr-primary);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
    border-bottom-color: var(--clr-primary);
  }

  .submit-btn {
    align-self: flex-end;
    margin-top: var(--sp-xs);
    padding: 0.8rem 2.2rem;
    background: var(--clr-text);
    color: var(--clr-bg);
    border: 2px solid var(--clr-text);
    border-radius: 0;
    font-family: var(--ff-copy, sans-serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.1s ease;
  }

  .submit-btn:hover,
  .submit-btn:focus-visible {
    background: transparent;
    color: var(--clr-text);
    border-color: var(--clr-text);
    outline: none;
  }

  .submit-btn:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .submit-btn:active {
    transform: translateY(1px);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--clr-text);
    color: var(--clr-bg);
    border-color: var(--clr-text);
    transform: none;
  }

  .form-status {
    margin-top: 1rem;
    font-size: 0.9rem;
    font-family: var(--ff-copy, sans-serif);
    padding: 1rem;
    border-radius: 4px;
    display: none;
  }

  .form-status.sending,
  .form-status.success,
  .form-status.error {
    display: block;
  }

  .form-status.success {
    background: var(--clr-surface);
    color: var(--clr-primary);
    border: 1px solid var(--clr-primary);
    font-size: 1.1rem;
    text-align: center;
    padding: 2rem;
  }

  .form-status.error {
    background: rgba(255, 68, 68, 0.1);
    color: var(--clr-tertiary, #ff4444);
    border: 1px solid var(--clr-tertiary, #ff4444);
  }

  .form-status.sending {
    color: var(--clr-text-muted);
  }
</style>
