---
const { action = "/api/contact" } = Astro.props;

const lang = (Astro.currentLocale as "en" | "de") || "en";

const messages = {
  en: {
    name: "Name",
    email: "Email",
    message: "Message",
    send: "Send Message",
    sending: "Sending...",
    success: "Thanks — I'll be in touch!",
    error: "Something went wrong. Please try again.",
    networkError:
      "A server error occurred (500). Please try again later or reach out directly via hallo@davideiken.de.",
  },
  de: {
    name: "Name",
    email: "E-Mail",
    message: "Nachricht",
    send: "Nachricht senden",
    sending: "Wird gesendet...",
    success: "Danke dir, ich melde mich!",
    error: "Es ist ein Fehler aufgetreten. Bitte versuche es noch einmal.",
    networkError:
      "Es gab ein Server-Problem (Fehler 500). Bitte versuche es später noch einmal oder schreibe mir direkt an hallo@davideiken.de.",
  },
};

const t = messages[lang];

const privacyMessages = {
  en: {
    part1:
      "By submitting this form, you agree to the processing of your data for the purpose of handling your request. Further information can be found in the ",
    linkText: "privacy policy",
    part2: ".",
  },
  de: {
    part1:
      "Mit dem Absenden dieses Formulars erklärst du dich mit der Verarbeitung deiner Daten zum Zwecke der Kontaktaufnahme einverstanden. Weitere Informationen findest du in der ",
    linkText: "Datenschutzerklärung",
    part2: ".",
  },
};

const p = privacyMessages[lang];
const privacyUrl = lang === "de" ? "/privacy" : "/en/privacy";
---

<form
  class="contact-form"
  action={action}
  method="POST"
  id="contactForm"
  data-msg-sending={t.sending}
  data-msg-success={t.success}
  data-msg-error={t.error}
  data-msg-network={t.networkError}
  data-1p-ignore
>
  <div id="formStatus" class="form-status" aria-live="polite"></div>

  <div class="form-content">
    <div class="form-group honeypot" aria-hidden="true">
      <label for="fax">Fax (Leave this empty)</label>
      <input type="text" id="fax" name="fax" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="name">{t.name}</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="100"
          autocomplete="name"
        />
      </div>

      <div class="form-group">
        <label for="email">{t.email}</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          maxlength="100"
          autocomplete="email"
        />
      </div>
    </div>

    <div class="form-group">
      <label for="message">{t.message}</label>
      <textarea
        id="message"
        name="message"
        required
        minlength="10"
        maxlength="3000"
        rows="5"></textarea>
    </div>

    <div class="form-actions">
      <p class="privacy-note">
        {p.part1}<a href={privacyUrl}>{p.linkText}</a>{p.part2}
      </p>
      <button type="submit" class="submit-btn" id="submitBtn">{t.send}</button>
    </div>
  </div>
</form>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  const statusEl = document.getElementById("formStatus");
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

  if (form && statusEl && submitBtn) {
    const msgSending = form.dataset.msgSending || "Sending...";
    const msgSuccess = form.dataset.msgSuccess || "Success!";
    const msgError = form.dataset.msgError || "Error";
    const msgNetwork = form.dataset.msgNetwork || "Network error";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      statusEl.textContent = msgSending;
      statusEl.className = "form-status sending";
      statusEl.removeAttribute("role");
      form.classList.remove("is-error");
      submitBtn.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && result.success) {
          statusEl.textContent = msgSuccess;
          statusEl.className = "form-status success";
          statusEl.removeAttribute("role");
          form.classList.add("is-success");
          form.reset();
        } else {
          // If 500 error or validation error
          if (response.status === 500) {
            statusEl.textContent = msgNetwork;
          } else {
            statusEl.textContent = result.error || msgError;
          }
          statusEl.className = "form-status error";
          statusEl.setAttribute("role", "alert");
          form.classList.add("is-error");
          submitBtn.disabled = false;
        }
      } catch (err) {
        statusEl.textContent = msgNetwork;
        statusEl.className = "form-status error";
        statusEl.setAttribute("role", "alert");
        form.classList.add("is-error");
        submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-s);

    .form-content {
      display: flex;
      flex-direction: column;
      gap: var(--sp-m);
    }

    &.is-success .form-content {
      display: none;
    }

    .form-row {
      display: flex;
      flex-direction: column;
      gap: var(--sp-m);

      @media (min-width: 40em) {
        flex-direction: row;

        .form-group {
          flex: 1;
        }
      }
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .honeypot {
      display: none;
    }

    label {
      font-family: var(--ff-copy, sans-serif);
      font-size: var(--fs-xs);
      color: var(--clr-text-muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    input,
    textarea {
      font-family: inherit;
      font-size: inherit;
      padding: 0.75rem 0.5rem;
      border: none;
      border-block-end: 3px solid var(--clr-text);
      background: color-mix(in oklch, var(--clr-text) 5%, transparent);
      color: var(--clr-text);
      border-radius: 0.5rem;
      transition:
        border-color 0.2s ease,
        outline-color 0.2s ease;

      &:focus {
        outline-color: transparent;
      }

      &:focus-visible {
        outline: var(--focus-outline);
        outline-offset: var(--focus-outline-offset);
      }
    }

    &.is-error input,
    &.is-error textarea {
      border-block-end-color: var(--clr-danger);
      background-color: color-mix(in oklch, var(--clr-danger) 12%, transparent);
    }

    .submit-btn {
      align-self: flex-end;
      padding: 0.8rem 2.2rem;
      background: var(--clr-text);
      color: var(--clr-bg);
      border: 2px solid var(--clr-text);
      border-radius: 9999px;
      font-family: var(--ff-copy, sans-serif);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition:
        background-color 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.1s ease;

      &:hover,
      &:focus-visible {
        background: transparent;
        color: var(--clr-text);
        border-color: var(--clr-text);
        outline-color: transparent;
      }

      &:focus-visible {
        outline: var(--focus-outline);
        outline-offset: var(--focus-outline-offset);
      }

      &:active {
        transform: translateY(1px);
      }

      &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: var(--clr-text);
        color: var(--clr-bg);
        border-color: var(--clr-text);
        transform: none;
      }
    }

    .form-status {
      font-size: 0.9rem;
      font-family: var(--ff-copy, sans-serif);
      padding: 1rem;
      border-radius: 4px;
      display: none;
      text-wrap: balance;

      &.sending,
      &.success,
      &.error {
        display: block;
      }

      &.success {
        background: none;
        border: none;
        padding-block: var(--sp-xl);
        text-align: center;
        font-family: var(--ff-heading);
        font-size: clamp(2.5rem, 1.8rem + 5vw, 5.5rem);
        font-variation-settings: var(--fvs-h1);
        line-height: var(--lh-h1);
        letter-spacing: var(--ls-h1);
        color: var(--clr-primary);
        animation: contact-success-reveal 0.8s cubic-bezier(0.25, 1, 0.5, 1)
          both;
      }

      &.error {
        background: #000000;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-size: var(--fs-s);
        text-align: center;
        padding: 1.5rem;
        border-radius: 0.5rem;
      }

      &.sending {
        color: var(--clr-text-muted);
      }
    }

    .privacy-note {
      font-size: var(--fs-xs);
      font-style: italic;
      color: var(--clr-text-muted);
      line-height: 1.4;
      text-align: left;
    }

    .form-actions {
      display: flex;
      flex-direction: column;
      gap: var(--sp-xs);
    }
  }

  @keyframes contact-success-reveal {
    from {
      opacity: 0;
      transform: translateY(1.5em);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      clip-path: inset(0 0 0% 0);
    }
  }
</style>
