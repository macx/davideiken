---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import avatarImg from "../assets/images/davideiken-1200.jpg";
import SectionLabel from "./SectionLabel.astro";

const locale = Astro.currentLocale ?? "de";
const privacyHref = getRelativeLocaleUrl(
  locale,
  locale === "de" ? "datenschutz" : "privacy",
);
const imprintHref = getRelativeLocaleUrl(locale, "imprint");
const privacyLabel = locale === "de" ? "Datenschutz" : "Privacy";
const imprintLabel = locale === "de" ? "Impressum" : "Legal Notice";
---

<footer class="site-footer content-center">
  <div class="grid-auto">
    <div class="footer-col">
      <Image
        src={avatarImg}
        alt="David Eiken"
        class="footer-avatar"
        width={160}
        height={160}
        densities={[1.5, 2]}
      />

      <p class="footer-name">
        <strong>David Eiken</strong><br />
        <em>
          {locale === "de" ? "(geb. Maciejewski)" : "(born Maciejewski)"}
        </em>
      </p>

      <dl>
        <dt>Web:</dt>
        <dd class="web-links">
          <a href="https://davideiken.de">davideiken.de</a>
          <a href="https://hawk-gt1191.de">hawk-gt1191.de</a>
          <a href="https://technikwuerze.de">technikwuerze.de</a>
          <a href="https://starterguide.dev">starterguide.dev</a>
        </dd>
      </dl>
    </div>

    <div class="footer-col">
      <SectionLabel text="STACK" />

      <dl>
        <dt>{locale === "de" ? "Fundament:" : "Foundation:"}</dt>
        <dd>
          {
            locale === "de" ? (
              <>
                <strong>Semantisches HTML</strong> für Menschen, Assistive
                Technologie und <strong>KI</strong>&#xA0;·
              </>
            ) : (
              <>
                <strong>Semantic HTML</strong> for humans, assistive technology
                and <strong>AI</strong>&#xA0;·
              </>
            )
          }{" "}
          Modern&nbsp;CSS&#xA0;·&#xA0;TypeScript
        </dd>

        <dt>{locale === "de" ? "Frameworks & CM:" : "Frameworks & CMS:"}</dt>
        <dd>
          Astro&#xA0;· JSX&#xA0;· Markdown&#xA0;· MDX&#xA0;· Angular&#xA0;·
          PrimeNG&#xA0;· Kirby&#xA0;·&#xA0;PHP
        </dd>

        <dt>
          {locale === "de" ? "KI & Agentic Coding:" : "AI & Agentic Coding:"}
        </dt>
        <dd>
          Claude&#xA0;· Gemini&#xA0;· Antigravity&#xA0;· Copilot&#xA0;·
          Codex&#xA0;·{" "}
          {
            locale === "de"
              ? "Multi-Agenten-Workflows"
              : "Multi-agent workflows"
          }&#xA0;· MCP
        </dd>

        <dt>UX & Frontend:</dt>
        <dd>
          {
            locale === "de" ? (
              <>
                <strong>UX für Mensch und KI</strong> · Frustrationsfrei ·
                Mobile First · Responsive&nbsp;Design
              </>
            ) : (
              <>
                <strong>UX for Human and AI</strong> · Frustation free · Mobile
                First · Responsive&nbsp;Design
              </>
            )
          }
        </dd>

        <dt>Editorial & Media:</dt>
        <dd>
          {
            locale === "de" ? (
              <>
                Tutorials · Fachbeiträge (Print&nbsp;& Online) · Kolumne ·
                Podcast (Audio&nbsp;& Video)
              </>
            ) : (
              <>
                Tutorials · Technical articles (Print&nbsp;& Online) · Column ·
                Podcast (Audio&nbsp;& Video)
              </>
            )
          }
        </dd>
      </dl>
    </div>

    <div class="footer-col">
      <SectionLabel text="SETUP" />
      <dl>
        <dt>Build:</dt>
        <dd>
          {locale === "de" ? "28.02.1977 in Celle" : "Feb 28, 1977 in Celle"}
        </dd>

        <dt>Roots:</dt>
        <dd>
          {
            locale === "de"
              ? "Minden, NRW – fest verwurzelt"
              : "Minden, NRW – deeply rooted"
          }
        </dd>

        <dt>Deploy:</dt>
        <dd>
          {
            locale === "de" ? (
              <>Remote Deutschland, hybrid&nbsp;& DACH auf Anfrage</>
            ) : (
              <>Remote Germany, hybrid&nbsp;& DACH on request</>
            )
          }
        </dd>

        <dt>Languages:</dt>
        <dd>
          {
            locale === "de"
              ? "Deutsch (Muttersprache), Englisch (fluent enough)"
              : "German (Native), English (fluent enough)"
          }
        </dd>

        <dt>Start:</dt>
        <dd>
          {locale === "de" ? "sofort" : "immediately"}
        </dd>
      </dl>
    </div>
  </div>

  <div class="meta">
    <nav class="legal-nav" aria-label="Legal">
      <a href={imprintHref}>{imprintLabel}</a>
      <a href={privacyHref}>{privacyLabel}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--sp-xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp);
    font-size: var(--fs-s);
  }

  .footer-avatar {
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-name {
    margin-block-end: var(--sp-2xs);
  }

  .footer-col {
    dl {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--sp-2xs);
      margin: 0;
    }

    dt {
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: var(--fs-2xs);

      &:not(:first-child) {
        margin-block-start: var(--sp);
      }
    }

    dd {
      margin: 0;
    }
  }

  .web-links {
    display: flex;
    flex-direction: column;

    a {
      display: inline-block;
      padding-block: var(--sp-2xs);
    }
  }

  .legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-m);
    align-items: center;
    inline-size: 100%;
    justify-content: center;

    @media (min-width: 768px) {
      justify-content: flex-end;
    }
  }

  .legal-nav a {
    font-size: var(--fs-xs);
    color: var(--clr-text-muted);
    text-decoration: none;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;

    &:hover,
    &:focus-visible {
      color: var(--clr-text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
  }
</style>
