---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import avatarImg from "../assets/images/davideiken-1200.jpg";
import SectionLabel from "./SectionLabel.astro";

const locale = Astro.currentLocale ?? "de";
const privacyHref =
  locale === "de"
    ? getRelativeLocaleUrl(locale, "datenschutz")
    : getRelativeLocaleUrl(locale, "privacy");
const imprintHref = getRelativeLocaleUrl(locale, "imprint");
const privacyLabel = locale === "de" ? "Datenschutz" : "Privacy";
const imprintLabel = locale === "de" ? "Impressum" : "Legal Notice";
---

<footer class="site-footer content-center">
  <div class="grid-auto">
    <div class="footer-col">
      <Image
        src={avatarImg}
        alt="David Eiken"
        class="footer-avatar"
        width={160}
        height={160}
        densities={[1.5, 2]}
      />

      <p class="footer-name">
        <strong>David Maciejewski</strong><br />
        <em>
          {
            locale === "de"
              ? "(ab 21. August 2026: Eiken)"
              : "(from August 21, 2026: Eiken)"
          }
        </em>
      </p>

      <dl>
        <dt>Web:</dt>
        <dd>
          <a href="https://davideiken.de">davideiken.de</a><br />
          <a href="https://hawk-gt1191.de">hawk-gt1191.de</a><br />
          <a href="https://technikwuerze.de">technikwuerze.de</a>
        </dd>
      </dl>
    </div>

    <div class="footer-col">
      <SectionLabel text="STACK" />

      <dl>
        <dt>{locale === "de" ? "Fundament:" : "Foundation:"}</dt>
        <dd>HTML&#xA0;· CSS&#xA0;·&#xA0;TypeScript</dd>

        <dt>{locale === "de" ? "Frameworks & CM:" : "Frameworks & CMS:"}</dt>
        <dd>
          Astro&#xA0;· Angular&#xA0;· PrimeNG&#xA0;· JSX&#xA0;· MDX&#xA0;·
          Markdown&#xA0;· Kirby&#xA0;·&#xA0;PHP
        </dd>

        <dt>
          {locale === "de" ? "KI & Agentic Coding:" : "AI & Agentic Coding:"}
        </dt>
        <dd>
          Copilot&#xA0;· Antigravity&#xA0;· Claude&#xA0;· Codex&#xA0;·
          {
            locale === "de"
              ? "Multi-Agenten-Workflows"
              : "Multi-agent workflows"
          }
        </dd>

        <dt>UX & Frontend:</dt>
        <dd>
          {
            locale === "de"
              ? "UX-Experte · Design-to-Code · Mobile First · Responsive Design"
              : "UX expert · Design-to-Code · Mobile First · Responsive Design"
          }
        </dd>
      </dl>
    </div>

    <div class="footer-col">
      <SectionLabel text="SETUP" />
      <dl>
        <dt>Build:</dt>
        <dd>
          {locale === "de" ? "28.02.1977 in Celle" : "Feb 28, 1977 in Celle"}
        </dd>

        <dt>Roots:</dt>
        <dd>
          {
            locale === "de"
              ? "Minden, NRW – fest verwurzelt"
              : "Minden, NRW – deeply rooted"
          }
        </dd>

        <dt>Deploy:</dt>
        <dd>
          {
            locale === "de"
              ? "Remote Deutschland, hybrid & DACH auf Anfrage"
              : "Remote Germany, hybrid & DACH on request"
          }
        </dd>

        <dt>Languages:</dt>
        <dd>
          {
            locale === "de"
              ? "Deutsch (Muttersprache), Englisch (fließend)"
              : "German (Native), English (Fluent)"
          }
        </dd>
      </dl>
    </div>
  </div>

  <div class="footer-meta">
    <nav class="legal-nav" aria-label="Legal">
      <a href={privacyHref} class="legal-link">{privacyLabel}</a>
      <a href={imprintHref} class="legal-link">{imprintLabel}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--sp-xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp);
    font-size: var(--fs-s);
  }

  .footer-avatar {
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-name {
    margin-block-end: var(--sp-2xs);
  }

  .footer-col {
    dl {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--sp-2xs);
      margin: 0;
    }

    dt {
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: var(--fs-2xs);

      &:not(:first-child) {
        margin-block-start: var(--sp);
      }
    }

    dd {
      margin: 0;
    }
  }

  .footer-meta {
    margin-block-start: var(--sp-l);
    padding-block-start: var(--sp-l);
    border-top: 1px solid var(--clr-line);
  }

  .legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    align-items: center;
    border: 1px solid var(--clr-text);
    width: fit-content;
  }

  .legal-link {
    display: inline-flex;
    align-items: center;
    padding: var(--sp-s) var(--sp-m);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-text);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;

    &:first-child {
      border-right: 1px solid var(--clr-text);
    }

    &:hover,
    &:focus-visible {
      background-color: var(--clr-text);
      color: var(--clr-bg);
    }
  }
</style>
