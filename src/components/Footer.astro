---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import avatarImg from "../assets/images/davideiken-1200.jpg";
import SectionLabel from "./SectionLabel.astro";

const locale = Astro.currentLocale ?? "de";
const privacyHref = getRelativeLocaleUrl(
  locale,
  locale === "de" ? "datenschutz" : "privacy",
);
const imprintHref = getRelativeLocaleUrl(locale, "imprint");
const privacyLabel = locale === "de" ? "Datenschutz" : "Privacy";
const imprintLabel = locale === "de" ? "Impressum" : "Legal Notice";
---

<footer class="site-footer content-center">
  <div class="grid-auto">
    <div class="footer-col">
      <Image
        src={avatarImg}
        alt="David Eiken"
        class="footer-avatar"
        width={160}
        height={160}
        densities={[1.5, 2]}
      />

      <p class="footer-name">
        <strong>David Eiken</strong><br />
        <em>
          {
            locale === "de"
              ? "(vormals David Maciejewski)"
              : "(formerly David Maciejewski)"
          }
        </em>
      </p>

      <dl>
        <dt>Web:</dt>
        <dd class="web-links">
          <a href="https://davideiken.de">davideiken.de</a>
          <a href="https://frustfrei.dev">frustfrei.dev</a>
          <a href="https://technikwuerze.de">technikwuerze.de</a>
        </dd>
      </dl>
    </div>

    <div class="footer-col footer-stack">
      <SectionLabel text="STACK" />

      <dl class="stack-list">
        <div>
          <dt>AI & Agentic Coding:</dt>
          <dd>
            {
              locale === "de" ? (
                <>
                  <strong>Agenten steuern, Qualität verantworten</strong>&#xA0;·
                </>
              ) : (
                <>
                  <strong>Directing agents, owning quality</strong>&#xA0;·
                </>
              )
            }{" "}
            Spec-Driven Development&#xA0;· Context Engineering&#xA0;· Multi-Agent
            Orchestration&#xA0;· Agent Skills&#xA0;· MCP&#xA0;· Plugins&#xA0;· Claude&#xA0;Code&#xA0;·
            Codex&#xA0;· Gemini&#xA0;· Copilot&#xA0;·&#xA0;Antigravity
          </dd>
        </div>

        <div>
          <dt>{locale === "de" ? "Fundament:" : "Foundation:"}</dt>
          <dd>
            {
              locale === "de" ? (
                <>
                  <strong>Semantisches HTML</strong> für Menschen, Assistive
                  Technologie und <strong>KI</strong>&#xA0;·
                </>
              ) : (
                <>
                  <strong>Semantic HTML</strong> for humans, assistive
                  technology and <strong>AI</strong>&#xA0;·
                </>
              )
            }{" "}
            Native&nbsp;CSS&#xA0;·&#xA0;Tailwind CSS&#xA0;·&#xA0;TypeScript
          </dd>
        </div>

        <div>
          <dt>{locale === "de" ? "Frameworks & CM:" : "Frameworks & CMS:"}</dt>
          <dd>
            {
              locale === "de" ? (
                <strong>Technologieoffen</strong>
              ) : (
                <strong>Technology-agnostic</strong>
              )
            }
            &#xA0;· Astro&#xA0;· JSX&#xA0;· Markdown&#xA0;· MDX&#xA0;· Angular&#xA0;·
            React&#xA0;· Vue.js&#xA0;· PrimeNG&#xA0;· Kirby&#xA0;·&#xA0;PHP
          </dd>
        </div>

        <div>
          <dt>Tooling & Deploy:</dt>
          <dd>
            Git&#xA0;· CI/CD Pipelines (GitHub Actions, Azure DevOps)&#xA0;·
            Deployment Automation&#xA0;· Prettier&#xA0;·
            Vitest&#xA0;·&#xA0;Playwright
          </dd>
        </div>

        <div>
          <dt>UX & Frontend:</dt>
          <dd>
            {
              locale === "de" ? (
                <>
                  <strong>Frustrationsfreie UX für Mensch und KI</strong>&#xA0;·
                  Accessibility&#xA0;· Usability&#xA0;· Design Systems&#xA0;·
                  Corporate Design&#xA0;· AI-Driven Prototyping&#xA0;·
                  Mobile&nbsp;First&#xA0;· Responsive&nbsp;Design
                </>
              ) : (
                <>
                  <strong>Frustration-free UX for humans and AI</strong>&#xA0;·
                  Accessibility&#xA0;· Usability&#xA0;· Design systems&#xA0;·
                  Corporate design&#xA0;· AI-driven prototyping&#xA0;·
                  Mobile&nbsp;First&#xA0;· Responsive&nbsp;Design
                </>
              )
            }
          </dd>
        </div>

        <div>
          <dt>Editorial & Media:</dt>
          <dd>
            {
              locale === "de" ? (
                <>
                  Tutorials&#xA0;· Fachbeiträge (Print&nbsp;& Online)&#xA0;·
                  Kolumne&#xA0;·&#xA0;Podcast (Audio&nbsp;& Video)
                </>
              ) : (
                <>
                  Tutorials&#xA0;· Technical articles (Print&nbsp;&
                  Online)&#xA0;· Column&#xA0;·&#xA0;Podcast (Audio&nbsp;& Video)
                </>
              )
            }
          </dd>
        </div>
      </dl>
    </div>

    <div class="footer-col">
      <SectionLabel text="SETUP" />
      <dl>
        <dt>Build:</dt>
        <dd>
          {
            locale === "de" ? (
              <>
                Neugierig&#xA0;· Eigenverantwortlich&#xA0;· Kommunikationsstark&#xA0;·
                Teamplayer&#xA0;· Lösungsorientiert&#xA0;·&#xA0;Pragmatisch
              </>
            ) : (
              <>
                Curious&#xA0;· Self-driven&#xA0;· Strong communicator&#xA0;·
                Team player&#xA0;· Solution-oriented&#xA0;·&#xA0;Pragmatic
              </>
            )
          }
        </dd>

        <dt>Roots:</dt>
        <dd>
          {
            locale === "de"
              ? "Minden, NRW – fest verwurzelt"
              : "Minden, NRW – deeply rooted"
          }
        </dd>

        <dt>Deploy:</dt>
        <dd>
          {
            locale === "de" ? (
              <>Remote Deutschland, hybrid&nbsp;& DACH auf Anfrage</>
            ) : (
              <>Remote Germany, hybrid&nbsp;& DACH on request</>
            )
          }
        </dd>

        <dt>Languages:</dt>
        <dd>
          {
            locale === "de"
              ? "Deutsch (Muttersprache), Englisch (fluent enough)"
              : "German (Native), English (fluent enough)"
          }
        </dd>

        <dt>Start:</dt>
        <dd>
          {locale === "de" ? "sofort" : "immediately"}
        </dd>

        <dt>Collaboration:</dt>
        <dd>Agile (Scrum & Kanban)&#xA0;·&#xA0;Code Reviews</dd>
      </dl>
    </div>
  </div>

  <div class="meta">
    <nav class="legal-nav" aria-label="Legal">
      <a href={imprintHref}>{imprintLabel}</a>
      <a href={privacyHref}>{privacyLabel}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--sp-xl);

    @media (min-width: 60em) {
      --max-width: var(--max-width-footer);

      /* Four equal tracks: the stack spans two, so its sub-columns match Setup */
      .grid-auto {
        grid-template-columns: 0.75fr repeat(3, 1fr);
      }

      .footer-stack {
        grid-column: span 2;
      }
    }
  }

  .footer-col .stack-list {
    row-gap: calc(var(--sp) + var(--sp-2xs));

    > div {
      display: grid;
      align-content: start;
      gap: var(--sp-2xs);
    }

    @media (min-width: 60em) {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--sp-content);

      /* The text-heavy first and the last entry span both columns */
      > div:first-child,
      > div:last-child {
        grid-column: 1 / -1;
      }
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp);
    font-size: var(--fs-s);
  }

  .footer-avatar {
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-name {
    margin-block-end: var(--sp-2xs);
  }

  .footer-col {
    dl {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--sp-2xs);
      margin: 0;
    }

    dt {
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: var(--fs-2xs);

      &:not(:first-child) {
        margin-block-start: var(--sp);
      }
    }

    dd {
      margin: 0;
    }
  }

  .web-links {
    display: flex;
    flex-direction: column;

    a {
      display: inline-block;
      padding-block: var(--sp-2xs);
    }
  }

  .legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-m);
    align-items: center;
    inline-size: 100%;
    justify-content: center;

    @media (min-width: 768px) {
      justify-content: flex-end;
    }
  }

  .legal-nav a {
    font-size: var(--fs-xs);
    color: var(--clr-text-muted);
    text-decoration: none;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;

    &:hover,
    &:focus-visible {
      color: var(--clr-text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
  }
</style>
