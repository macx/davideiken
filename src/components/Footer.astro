---
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "en";
const privacyHref = getRelativeLocaleUrl(locale, "privacy/construction-camera");
const imprintHref = getRelativeLocaleUrl(locale, "imprint");

const rights =
  locale === "de" ? "Alle Rechte vorbehalten." : "All rights reserved.";
const privacyLabel = locale === "de" ? "Datenschutz" : "Privacy";
const imprintLabel = locale === "de" ? "Impressum" : "Legal Notice";
const profileNotice =
  locale === "de"
    ? "Hinweis: Diese Website ist ein berufliches Profil zur Bewerbung als UI/UX Frontend Engineer. Über diese Website werden keine Dienstleistungen angeboten oder verkauft."
    : "Note: This website is a professional profile used for job applications as a UI/UX Frontend Engineer. No services are offered or sold through this website.";
---

<footer class="site-footer">
  <div class="container">
    <p>&copy; {new Date().getFullYear()} David Maciejewski. {rights}</p>
    <p class="footer-note">{profileNotice}</p>
    <p class="footer-links">
      <a href={privacyHref}>{privacyLabel}</a>
      <span aria-hidden="true"> · </span>
      <a href={imprintHref}>{imprintLabel}</a>
    </p>
  </div>
</footer>
