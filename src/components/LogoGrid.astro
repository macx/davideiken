---
import Tooltip from "./Tooltip.astro";
import { brandLogos, logoSymbolId } from "../data/brandLogos";
---

<div class="logo-grid">
  {
    brandLogos.map((logo) => (
      <Tooltip
        as="div"
        class="logo-item"
        text={logo.name}
        style={`--scale: ${logo.scale};`}
        role="img"
        aria-label={logo.name}
      >
        <svg aria-hidden="true" focusable="false">
          <use href={`/sprites/logos.svg#${logoSymbolId(logo.file)}`} />
        </svg>
      </Tooltip>
    ))
  }
</div>

<style>
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    row-gap: var(--sp-m);
    column-gap: var(--sp-l);
    margin-block: var(--sp-xl);
    align-items: center;
    justify-items: center;
  }

  .logo-grid :global(.logo-item) {
    display: flex;
    justify-content: center;
    align-items: center;

    inline-size: 100%;
    max-inline-size: 140px;
    block-size: 60px;
    transition: background-color 0.3s ease;
  }

  /* SVG variables for dark mode fallback */
  :root {
    --logo-fallback-bg: transparent;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) {
      --logo-fallback-bg: #ffffff;
    }
  }

  :global([data-theme="dark"]) {
    --logo-fallback-bg: #ffffff;
  }

  .logo-grid :global(.logo-item svg) {
    width: 100%;
    height: 100%;
    /* 
      We scale the SVG using a transform. This ensures the grid cell 
      remains consistent (e.g. 140x60) while the visual size of the 
      logo is adjusted up or down to match the layout. 
    */
    transform: scale(var(--scale, 1));
  }
</style>
