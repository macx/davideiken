---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
}

// Mobile-first sizes: the narrow-viewport rule is listed first, the content
// column's max-width (--max-width: 50rem = 800px) is the fallback for wider
// screens. Widths cover common phone/tablet/desktop breakpoints at both 1x
// and up to ~2x pixel density, capped at 1600 so retina never pulls in more
// than a modest upgrade over the 800px desktop rendering size.
const {
  src,
  alt,
  caption,
  widths = [400, 640, 800, 1200, 1600],
  sizes = "(max-width: 48em) 100vw, 800px",
} = Astro.props;
---

<figure class="full-bleed-figure">
  <Image src={src} alt={alt} format="webp" widths={widths} sizes={sizes} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .full-bleed-figure {
    margin-block: var(--sp-l);
    margin-inline: 0;
  }

  .full-bleed-figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--sp-2xs);
    border: 1px solid var(--clr-outline);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  figcaption {
    margin-block-start: var(--sp-xs);
    font-size: var(--fs-xs);
    color: var(--clr-text-muted);
    text-align: center;
  }
</style>
