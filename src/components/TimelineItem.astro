---
import Tooltip from "./Tooltip.astro";
import workIcon from "../assets/icons/work.svg?raw";
import cognitionIcon from "../assets/icons/cognition.svg?raw";
import emojiObjectsIcon from "../assets/icons/emoji-objects.svg?raw";

export interface Props {
  date: string;
  title: string;
  company: string;
  impact: string;
  type: "freelance" | "employed" | "education";
  isOffset?: boolean;
  gridRow?: number;
}

const {
  date,
  title,
  company,
  impact,
  type,
  isOffset = false,
  gridRow,
} = Astro.props;

// SVG Icons mapping for timeline types
const ICONS = {
  freelance: emojiObjectsIcon,
  employed: workIcon,
  education: cognitionIcon,
};

const TOOLTIPS = {
  freelance: "Selbstständigkeit",
  employed: "Anstellung",
  education: "Weiterbildung & Studium",
};
---

<li
  class={`timeline-item type-${type} ${isOffset ? "is-offset" : ""} ${gridRow === 0 ? "is-lead-row" : ""}`}
  style={gridRow !== undefined ? `--grid-row: ${gridRow + 1}` : undefined}
>
  <div class="timeline-content">
    <div class="timeline-meta">
      <span class="timeline-date">{date}</span>
      <Tooltip text={TOOLTIPS[type]} class="timeline-icon-tooltip">
        <span class="timeline-icon" set:html={ICONS[type]} />
      </Tooltip>
      <span class="timeline-dot"></span>
    </div>
    <div class="timeline-body">
      <h3 class="timeline-title">{title}</h3>
      <p class="timeline-company">{company}</p>
      <div class="timeline-impact">
        <span class="impact-label">
          {type === "education" ? "LEARNINGS" : "IMPACT"}:
        </span>{" "}
        {impact}
      </div>
    </div>
  </div>
</li>

<style>
  .timeline-item {
    position: relative;
    margin-block-end: var(--sp-2xl);
  }
  .timeline-item:last-child {
    margin-block-end: 0;
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-s);
    margin-block-end: var(--sp-s);
    position: relative;
  }

  .timeline-date {
    display: inline-block;
    padding-block: 0.2rem;
    padding-inline: 0.8rem;
    border: 1px solid var(--clr-text-muted);
    border-radius: 99px;
    font-size: var(--fs-xs);
    font-weight: 600;
    white-space: nowrap;
    background: var(--clr-surface);
  }

  .timeline-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-text-muted);
  }

  .timeline-icon :global(svg) {
    inline-size: 1em;
    block-size: 1em;
    fill: currentColor;
  }

  .timeline-meta::before {
    content: "";
    display: none; /* hidden on mobile, line is vertical only */
  }

  .timeline-dot {
    display: block;
    position: absolute;
    inset-inline-start: -25px; /* aligns perfectly with the extreme left 10px center line on mobile */
    inset-block-start: 50%;
    transform: translateY(-50%);
    inline-size: 13px;
    block-size: 13px;
    border-radius: 50%;
    z-index: 2;
    transition:
      inset-inline-start 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      inset-inline-end 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Specific dot colors based on type */
  .type-freelance .timeline-dot {
    background: var(--clr-primary);
  }
  .type-employed .timeline-dot {
    background: var(--clr-text);
  }
  .type-education .timeline-dot {
    background: var(--clr-text-muted);
  }

  .timeline-title {
    font-size: var(--fs-m);
    font-weight: 800;
    margin: 0;
    line-height: 1.2;
  }

  .timeline-company {
    font-size: var(--fs-s);
    color: var(--clr-text-muted);
    margin-block: 0 var(--sp-s);
    margin-inline: 0;
  }

  .timeline-impact {
    font-size: var(--fs-s);
    line-height: 1.6;
    color: var(--clr-text);
    text-wrap: pretty;
  }

  .impact-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: block;
    margin-block-end: 0.2rem;
  }

  /* Unveil Animation for Scroll */
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      @keyframes unveil {
        from {
          opacity: 0;
          transform: translateY(
            10em
          ); /* intensified slide-in without scaling to avoid line drifting */
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes unveil-slide {
        from {
          transform: translateY(2em);
        }
        to {
          transform: translateY(0);
        }
      }

      .timeline-item {
        animation: unveil auto linear both;
        animation-timeline: view(block);
        animation-range: entry 10% cover 35%;

        /* Lead row can sit only partially inside the viewport on load,
           leaving the view-timeline's entry phase unresolved -- which
           shows up as a leftover translateY offset before any scroll.
           A short, opacity-free slide keeps that leftover offset small
           enough to be unnoticeable while still animating in. */
        &.is-lead-row {
          animation-name: unveil-slide;
        }
      }
    }
  }

  /* --- Desktop Layout --- */
  @media (min-width: 768px) {
    .mobile-only {
      display: none;
    }

    .timeline-item {
      margin-block-end: var(--sp-xl);
      grid-row: var(--grid-row);
    }

    .timeline-item:last-child {
      margin-block-end: var(--sp-xl);
    }

    .timeline-item.is-offset {
      margin-block-start: 4em;
    }

    .timeline-meta {
      margin-block-end: var(--sp-m);
      display: flex;
      position: relative; /* relative to position the absolute line and dot */

      /* Configurable variables in relative units */
      --c-dot-size: 0.625em; /* ~10px at base 16px */
      --c-dot-gap: 0.75em; /* ~12px at base 16px */
      --c-line-thickness: 0.125em; /* ~2px at base 16px */
      --c-line-offset: calc(var(--c-dot-gap) + var(--c-dot-size));
    }

    .impact-label {
      display: inline;
      margin-inline-end: 0.2rem;
    }

    /* Common styles for the Dot and Line (::before) */
    .timeline-dot {
      display: block;
      position: absolute;
      inset-block-start: 50%;
      inline-size: var(--c-dot-size);
      block-size: var(--c-dot-size);
      border-radius: 50%;
      z-index: 2;
      box-sizing: border-box;
      transform: translateY(-50%);
    }

    .timeline-meta::before {
      content: "";
      display: block;
      position: absolute;
      inset-block-start: 50%;
      block-size: var(--c-line-thickness);
      z-index: 1;
      transform: translateY(-50%);
    }

    /* Freelance & Education (Left Column) */
    .type-freelance,
    .type-education {
      grid-column: 1;
      text-align: end;
    }

    .type-freelance .timeline-meta,
    .type-education .timeline-meta {
      justify-content: flex-start;
      flex-direction: row-reverse;
    }

    /* Position the dots in the middle of the gap, completely outside the content */
    .type-freelance .timeline-dot,
    .type-education .timeline-dot {
      inset-inline-start: calc(100% + var(--c-dot-gap));
      inset-inline-end: auto;
    }

    .type-freelance .timeline-dot {
      background: var(--clr-primary);
    }

    .type-education .timeline-dot {
      background: var(--clr-text-muted);
      opacity: 0.5;
    }

    /* Spanning lines from the dot edge to the center vertical line */
    .type-freelance .timeline-meta::before {
      inset-inline-start: calc(100% + var(--c-line-offset));
      inset-inline-end: calc(-1 * var(--c-timeline-gap) - 1px);
      background: var(--clr-primary);
    }

    .type-education .timeline-meta::before {
      inset-inline-start: calc(100% + var(--c-line-offset));
      inset-inline-end: calc(-1 * var(--c-timeline-gap) - 1px);
      background: var(--clr-text-muted);
      opacity: 0.5;
    }

    /* Employed (Right Column) */
    .type-employed {
      grid-column: 3;
      text-align: start;
    }

    .type-employed .timeline-meta {
      justify-content: flex-start;
      flex-direction: row;
    }

    /* Position the dots in the middle of the gap, completely outside the content */
    .type-employed .timeline-dot {
      inset-inline-end: calc(100% + var(--c-dot-gap));
      inset-inline-start: auto;
      background: var(--clr-text);
    }

    /* Spanning lines from the dot edge to the center vertical line */
    .type-employed .timeline-meta::before {
      inset-inline-end: calc(100% + var(--c-line-offset));
      inset-inline-start: calc(-1 * var(--c-timeline-gap) - 1px);
      background: var(--clr-text);
    }
  }
</style>
