---
import ContactForm from "./ContactForm.astro";

const locale = Astro.currentLocale ?? "en";
const title =
  locale === "de" ? "Kein Pitch, kein Druck." : "No pitch, no pressure.";
const text =
  locale === "de"
    ? "Buche dir ein unverbindliches Online-Meeting. Nur ein offenes Gespräch darüber, wie ich dein Team ergänzen kann. Oder hinterlasse mir eine Nachricht."
    : "Book a no-strings-attached online meeting. Just an open conversation about how I can complement your team. Or leave me a message.";
---

<section id="contact" class="contact">
  <div class="content-center">
    <h2>{title}</h2>

    <p>
      {text}
    </p>

    <div class="contact-action">
      <ContactForm action="/api/contact" />
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--clr-surface);
    padding-block: var(--sp-2xl);
    border-block: 1px solid var(--clr-line);

    h2 {
      margin-block-start: 0;
    }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-l);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-action {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
