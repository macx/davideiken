---
import ContactForm from "./ContactForm.astro";

const locale = Astro.currentLocale ?? "en";
const title =
  locale === "de"
    ? "Lass uns ins Gespräch kommen."
    : "Let’s start a conversation.";

const textPart1 =
  locale === "de"
    ? "Ich freue mich über einen unverbindlichen Austausch darüber, wie ich dein Team ergänzen kann. Buche dir gern einen Termin unter "
    : "I’d love an open exchange about how I can complement your team. Feel free to book a time at ";

const linkUrl = "https://davideiken.de/meeting";
const linkText = "davideiken.de/meeting";

const textPart2 =
  locale === "de"
    ? ", oder schreib mir direkt."
    : ", or just drop me a message.";
---

<section id="contact" class="contact">
  <div class="content-center">
    <h2>{title}</h2>

    <p>
      {textPart1}<a href={linkUrl} target="_blank" rel="noopener">{linkText}</a
      >{textPart2}
    </p>

    <div class="contact-action">
      <ContactForm action="/api/contact/" />
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--clr-surface);
    padding-block: var(--sp-2xl);
    border-block: 1px solid var(--clr-line);

    h2 {
      margin-block-start: 0;
    }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-l);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-action {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
