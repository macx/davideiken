---
interface Props {
  title?: string;
  description?: string;
  frontmatter?: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title || "David Eiken";
const description = frontmatter?.description || Astro.props.description || "David Eiken";

import { Font } from "astro:assets";
import "../styles/main.css";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import ContactSection from "../components/ContactSection.astro";

const locale = Astro.url.pathname.startsWith("/en") ? "en" : "de";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--ff-copy" preload />
    <Font cssVariable="--ff-heading" preload />
    <meta name="generator" content={Astro.generator} />
    <title>{title === "David Eiken" ? title : `${title} | David Eiken`}</title>
    <script is:inline>
      // Language Detection & Redirect (only on root path)
      if (window.location.pathname === "/") {
        const hasRedirected = sessionStorage.getItem("lang_redirected");
        if (!hasRedirected) {
          const userLang = navigator.language || navigator.userLanguage;
          if (userLang && !userLang.toLowerCase().startsWith("de")) {
            sessionStorage.setItem("lang_redirected", "true");
            window.location.replace(
              "/en/" + window.location.search + window.location.hash,
            );
          }
        }
      }

      const theme = localStorage.getItem("theme") || "auto";
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <SiteHeader />

    <main>
      <div class="editorial-layout">
        <slot />
      </div>
    </main>

    <ContactSection />
    <Footer />
  </body>
</html>
