---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  frontmatter?: {
    title?: string;
    description?: string;
    noindex?: boolean;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title || "David Eiken";
const description =
  frontmatter?.description || Astro.props.description || "David Eiken";
const noindex = frontmatter?.noindex ?? Astro.props.noindex ?? false;

import { Font } from "astro:assets";
import "../styles/main.css";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import ContactSection from "../components/ContactSection.astro";
import { getAlternates } from "../i18n/routes";
import { stripMarkdown } from "../utils/text";

// Frontmatter titles/descriptions may contain Markdown (e.g. "__Bold__") meant
// for on-page rendering via PageHeader -- <title> and <meta> need plain text.
const cleanTitle = stripMarkdown(title);
const cleanDescription = stripMarkdown(description);

const locale = Astro.url.pathname.startsWith("/en") ? "en" : "de";
// The 404 page renders for arbitrary, non-existent paths -- a canonical/
// hreflang tag pointing at those would be an SEO anti-pattern, so skip both.
const isErrorPage = Astro.response.status === 404;
const alternates = isErrorPage ? undefined : getAlternates(Astro.url.pathname);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={cleanDescription} />
    <meta name="viewport" content="width=device-width" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!isErrorPage && <link rel="canonical" href={canonicalUrl} />}
    {
      alternates && (
        <>
          <link
            rel="alternate"
            hreflang="de"
            href={new URL(alternates.de, Astro.site)}
          />
          <link
            rel="alternate"
            hreflang="en"
            href={new URL(alternates.en, Astro.site)}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(alternates.de, Astro.site)}
          />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--ff-copy" preload />
    <Font cssVariable="--ff-heading" preload />
    <meta name="generator" content={Astro.generator} />
    <title>
      {cleanTitle === "David Eiken"
        ? cleanTitle
        : `${cleanTitle} | David Eiken`}
    </title>
    <script is:inline>
      // Language Detection & Redirect (only on root path)
      if (window.location.pathname === "/") {
        const hasRedirected = sessionStorage.getItem("lang_redirected");
        if (!hasRedirected) {
          const userLang = navigator.language || navigator.userLanguage;
          if (userLang && !userLang.toLowerCase().startsWith("de")) {
            sessionStorage.setItem("lang_redirected", "true");
            window.location.replace(
              "/en/" + window.location.search + window.location.hash,
            );
          }
        }
      }

      const theme = localStorage.getItem("theme") || "auto";
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body data-1p-ignore>
    <SiteHeader />

    <main>
      <div class="content-center">
        <slot />
      </div>
    </main>

    <ContactSection />
    <Footer />
  </body>
</html>
