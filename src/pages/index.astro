---
import Layout from '../layouts/Layout.astro';
---

<Layout title="David Eiken - Home" description="Willkommen auf der Website von David Eiken">
  <div class="max-w-4xl mx-auto">
    <!-- Hero Section -->
    <section class="text-center py-12">
      <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-400 bg-clip-text text-transparent">
        Willkommen
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
        Dies ist die persönliche Website von David Eiken
      </p>
    </section>

    <!-- About Section -->
    <section class="mb-12 bg-gray-50 dark:bg-gray-800 rounded-lg p-8 shadow-lg transition-colors duration-300">
      <h2 class="text-3xl font-semibold mb-4 text-gray-800 dark:text-gray-100">
        Über diese Seite
      </h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 mb-4">
        Diese Website wurde mit modernen Webtechnologien entwickelt:
      </p>
      <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300">
        <li><strong>Astro JS</strong> - Das moderne Web-Framework</li>
        <li><strong>TypeScript</strong> - Typsichere Entwicklung</li>
        <li><strong>Tailwind CSS</strong> - Utility-first CSS Framework</li>
        <li><strong>MDX</strong> - Markdown mit JSX für Rich Content</li>
      </ul>
    </section>

    <!-- Features Section -->
    <section class="mb-12">
      <h2 class="text-3xl font-semibold mb-6 text-gray-800 dark:text-gray-100">
        Features
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-md hover:shadow-xl transition-shadow duration-300">
          <div class="text-3xl mb-3">🌓</div>
          <h3 class="text-xl font-semibold mb-2">Dark/Light Mode</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Wechseln Sie zwischen hellem und dunklem Design mit einem Klick. Die Einstellung wird gespeichert.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-md hover:shadow-xl transition-shadow duration-300">
          <div class="text-3xl mb-3">♿</div>
          <h3 class="text-xl font-semibold mb-2">Barrierefreiheit</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Die Website wurde mit Fokus auf Barrierefreiheit entwickelt, inklusive ARIA-Labels und Tastaturnavigation.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-md hover:shadow-xl transition-shadow duration-300">
          <div class="text-3xl mb-3">⚡</div>
          <h3 class="text-xl font-semibold mb-2">Schnell & Modern</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Gebaut mit Astro für optimale Performance und moderne Entwicklererfahrung.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-md hover:shadow-xl transition-shadow duration-300">
          <div class="text-3xl mb-3">📝</div>
          <h3 class="text-xl font-semibold mb-2">MDX Support</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Erstellen Sie reichhaltige Inhalte mit Markdown und integrierten React-Komponenten.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="text-center py-12 bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg text-white">
      <h2 class="text-3xl font-bold mb-4">
        Entdecken Sie mehr
      </h2>
      <p class="text-lg mb-6 opacity-90">
        Besuchen Sie unsere Baustellenkamera-Seite
      </p>
      <a
        href="/datenschutz/baustellenkamera"
        class="inline-block bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors duration-200 shadow-lg hover:shadow-xl"
      >
        Zur Baustellenkamera
      </a>
    </section>
  </div>
</Layout>
